{
    "id": "sr5-importer",
    "title": "Shadowrun 5e Importer",
    "description": "Import NPCs, critters, spirits, sprites, vehicles, gear, weapons, spells, powers and more into the Shadowrun 5th Edition system from JSON, plain text and PDF, many entries at a time.",
    "version": "0.1.7",
    "authors": [
        {
            "name": "Geek IO Dev Team",
            "url": "https://www.geek-io.net/discord"
        }
    ],
    "compatibility": {
        "minimum": "13",
        "verified": "14.367",
        "maximum": "14"
    },
    "relationships": {
        "systems": [
            {
                "id": "shadowrun5e",
                "type": "system",
                "compatibility": {}
            }
        ]
    },
    "esmodules": [
        "scripts/main.js"
    ],
    "styles": [
        "styles/importer.css"
    ],
    "languages": [
        {
            "lang": "en",
            "name": "English",
            "path": "lang/en.json"
        }
    ],
    "url": "https://github.com/geek-io/shadowrunimporterfoundry",
    "manifest": "https://github.com/geek-io/shadowrunimporterfoundry/releases/latest/download/module.json",
    "download": "https://github.com/geek-io/shadowrunimporterfoundry/releases/download/v0.1.7/module.zip",
    "readme": "README.md",
    "bugs": "https://github.com/geek-io/shadowrunimporterfoundry/issues",
    "flags": {
        "hotReload": {
            "extensions": [
                "css",
                "hbs",
                "json"
            ],
            "paths": [
                "styles",
                "templates",
                "lang"
            ]
        }
    }
}
